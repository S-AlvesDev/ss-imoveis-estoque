# Conexão com o Supabase (mesmo projeto do site principal ss-imoveis-platform)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Segredo usado para assinar/verificar os tokens JWT deste app
JWT_SECRET=troque_por_um_segredo_forte_em_producao

# Porta do servidor local
PORT=3001

# Origens externas autorizadas a chamar a API (separadas por vírgula).
# Vazio = apenas mesma origem, que é o esperado em produção.
# Ex.: ALLOWED_ORIGINS=https://painel.exemplo.com,https://staging.exemplo.com
ALLOWED_ORIGINS=
