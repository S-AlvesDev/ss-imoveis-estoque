# Conexão com o Supabase (mesmo projeto do site principal ss-imoveis-platform)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Segredo usado para assinar/verificar os tokens JWT deste app
JWT_SECRET=troque_por_um_segredo_forte_em_producao

# Porta do servidor local
PORT=3001

# Origens externas autorizadas a chamar a API (separadas por vírgula).
# Vazio = apenas mesma origem, que é o esperado em produção.
# Ex.: ALLOWED_ORIGINS=https://painel.exemplo.com,https://staging.exemplo.com
ALLOWED_ORIGINS=

# Confia no cabeçalho X-Forwarded-For para identificar o IP do cliente.
# Ligue APENAS se houver um proxy reverso na frente. Na Vercel é automático.
# Sem proxy, ligar isso deixa o cliente escolher o próprio IP e burlar o rate limit.
TRUST_PROXY=false

# Endereço público do site, sem barra no final. De fábrica é https://stokai.app;
# só defina para apontar um build de teste para outro lugar. Usado nas tags de
# prévia (og:image), no sitemap e no robots.txt do build.
VITE_SITE_URL=
# Mesma coisa para o servidor (links nos e-mails de recuperação de senha e boas-vindas).
# Vazio = VITE_SITE_URL, ou https://stokai.app. Ex. local: http://localhost:3001
SITE_URL=

# ---- E-mail (alertas de estoque, chamados, pedidos de demonstração) ----
# Qualquer SMTP. Com a caixa da Hostinger:
#   SMTP_HOST=smtp.hostinger.com  SMTP_PORT=465  SMTP_USER=team@stokai.app  SMTP_PASS=senha da caixa
# Tudo vazio = o sistema não manda e-mail e segue funcionando.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Remetente. Vazio = SMTP_USER (a Hostinger só envia como a própria caixa).
SMTP_FROM_EMAIL=
# Quem recebe alertas e chamados. Vazio = o remetente.
ADMIN_EMAIL=
# Quem recebe pedidos de demonstração da Home. Vazio = ADMIN_EMAIL.
DEMO_EMAIL=
# (Legado) Brevo — ainda funciona se SMTP_* estiver vazio.
# BREVO_SMTP_LOGIN=
# BREVO_SMTP_KEY=

# ---- Mercado Pago (assinaturas) ----
# Painel do MP → Suas integrações → a aplicação do Stok Aí → Credenciais de produção.
# Access token: cria/consulta assinaturas e cobranças (obrigatório para o webhook e o anual).
MP_ACCESS_TOKEN=
# Public key da mesma aplicação: vai ao navegador para o cartão ser digitado dentro do site (Checkout Transparente).
# Vazio = a pessoa paga no checkout do Mercado Pago e volta.
MP_PUBLIC_KEY=
# Painel → Webhooks → "Assinatura secreta": confere que o evento veio mesmo do MP.
# Vazio = aceita sem conferir (o servidor sempre rebusca o objeto na API, nunca confia no corpo).
MP_WEBHOOK_SECRET=
# Id (32 hex) de um plano barato criado no painel: entra no lugar do Essencial mensal só para testar o fluxo. Vazio em produção.
MP_PLANO_DE_TESTE=

# Cron da Vercel (lembretes de vencimento, uma vez por dia). A Vercel manda este valor no cabeçalho Authorization.
# Qualquer texto longo e aleatório. Vazio = a rota /api/cron/lembretes recusa tudo.
CRON_SECRET=

# ---- Nota fiscal de serviço (NFS-e) pelo Focus NFe ----
# Sem tudo isto preenchido, nada é emitido: o pagamento fica com nf_status = pendente para tratar à mão.
NFSE_PROVEDOR=focus
FOCUS_NFE_TOKEN=
# homologacao (padrão, notas de mentira) | producao
FOCUS_NFE_AMBIENTE=homologacao
NFSE_PRESTADOR_CNPJ=
NFSE_PRESTADOR_IM=
# Código IBGE do município do prestador (Natal/RN = 2408102)
NFSE_CODIGO_MUNICIPIO=
# Item da lista de serviços da LC 116 (ex.: 01.05 licenciamento de software)
NFSE_ITEM_LISTA_SERVICO=
# Só se a prefeitura exigir
NFSE_CODIGO_TRIBUTARIO_MUNICIPIO=
# Alíquota do ISS em %, ex.: 2
NFSE_ALIQUOTA=
NFSE_OPTANTE_SIMPLES=true

# Quem assina o recibo (não fiscal) enviado a cada pagamento. Vazio = "Stok Aí".
RECIBO_EMITENTE=
# CPF ou CNPJ do emitente: no recibo sai mascarado (***.456.789-**). Vazio = sem documento.
RECIBO_EMITENTE_DOC=

# ---- Stok Aí no WhatsApp ----
# A IA (console.anthropic.com → API keys). Sem ela o assistente responde que está desligado.
ANTHROPIC_API_KEY=
# Modelo. Vazio = claude-sonnet-5; claude-haiku-4-5-20251001 é mais barato para conversa simples.
ASSISTENTE_MODELO=
# Evolution API (o WhatsApp): a instalação no VPS, a chave global e a instância do número do Stok Aí.
EVOLUTION_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
# O que vai em ?token= na URL do webhook configurada na Evolution (qualquer texto longo). Obrigatório: sem ele o webhook recusa tudo.
EVOLUTION_WEBHOOK_TOKEN=
# O número conectado, só para mostrar na tela (ex.: 5584991434190).
EVOLUTION_NUMERO=

# ---- Erros (Sentry, opcional) ----
# sentry.io → projeto Node (servidor) e projeto React (navegador). Sem DSN, os erros ficam só no log.
SENTRY_DSN=
VITE_SENTRY_DSN=

