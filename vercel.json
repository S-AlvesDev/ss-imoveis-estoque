{
  "buildCommand": "npm run build:api && vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/atende",
      "destination": "/atende.html"
    },
    {
      "source": "/atende/:path*",
      "destination": "/atende.html"
    },
    {
      "source": "/cloud",
      "destination": "/cloud.html"
    },
    {
      "source": "/cloud/:path*",
      "destination": "/cloud.html"
    },
    {
      "source": "/((?!api/|atende|cloud).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/lembretes",
      "schedule": "0 12 * * *"
    }
  ]
}
